{
  "name": "Koliya — كُلِّيَّة",
  "short_name": "Koliya",
  "description": "Le réseau social privé des étudiants universitaires algériens.",
  "id": "/index_sm.html",
  "start_url": "/index_sm.html",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "any",
  "background_color": "#FAFAF9",
  "theme_color": "#2563EB",
  "lang": "fr",
  "dir": "auto",
  "categories": ["social", "education"],
  "prefer_related_applications": false,

  "icons": [
    { "src": "icons/icon-192.png",  "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png",  "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],

  "shortcuts": [
    {
      "name": "Messages",
      "short_name": "Messages",
      "description": "Ouvrir vos conversations",
      "url": "/index_sm.html#/messages",
      "icons": [{ "src": "icons/shortcut-messages.png", "sizes": "96x96" }]
    },
    {
      "name": "Nouvelle publication",
      "short_name": "Publier",
      "description": "Écrire une publication",
      "url": "/index_sm.html#/feed?compose=1",
      "icons": [{ "src": "icons/shortcut-compose.png", "sizes": "96x96" }]
    },
    {
      "name": "Notifications",
      "short_name": "Notifs",
      "description": "Voir vos notifications",
      "url": "/index_sm.html#/notifications",
      "icons": [{ "src": "icons/shortcut-bell.png", "sizes": "96x96" }]
    }
  ],

  "share_target": {
    "action": "/index_sm.html#/feed",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
